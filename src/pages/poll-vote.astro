---
import Layout from '../layouts/Layout.astro';
import PollVoting from '../components/PollVoting.svelte';

const token = Astro.url.searchParams.get('token') || '';
---

<Layout title="Vote on Poll - PSD">
  <div data-poll-token={token} style="display: none;">poll-token-marker</div>
  <PollVoting client:load pollId={token} />
</Layout>
