---
import Layout from '../layouts/Layout.astro';
import PollVoting from '../components/PollVoting.svelte';
---

<Layout title="Vote on Poll - PSD">
  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token') || '';
    if (token) {
      window.__POLL_TOKEN__ = token;
    }
  </script>
  <div data-poll-token="" style="display: none;">poll-token-marker</div>
  <PollVoting client:load pollId="" />
</Layout>
